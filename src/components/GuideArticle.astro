---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Section {
  heading: string;
  paragraphs?: string[];
  bullets?: string[];
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lead: string;
  sections: Section[];
  related: Array<{ href: string; label: string; text: string }>;
}

const { title, description, eyebrow, h1, lead, sections, related } = Astro.props;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  inLanguage: 'ja-JP',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  publisher: {
    '@type': 'Organization',
    name: 'Surfboard Finder',
  },
};
---
<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'ホーム', path: '/' },
    { name: '選び方ガイド', path: '/guides/' },
    { name: h1, path: Astro.url.pathname },
  ]}
>
  <SiteHeader />
  <main class="guide-page">
    <section class="guide-hero">
      <div class="container guide-hero-inner">
        <p class="kicker">{eyebrow}</p>
        <h1>{h1}</h1>
        <p class="guide-lead">{lead}</p>
        <div class="guide-actions">
          <a class="button button-primary" href="/diagnosis/">無料診断を試す</a>
          <a class="button button-ghost" href="/boards/">検証済みボードを見る</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container guide-shell">
        <article class="guide-article">
          {sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs?.map((p) => <p>{p}</p>)}
              {section.bullets?.length && (
                <ul>
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))}
        </article>

        <aside class="guide-side">
          <div class="guide-side-card">
            <p class="kicker">NEXT STEP</p>
            <h2>読むだけで決めない。</h2>
            <p>候補の方向が見えたら、今の技術・波・悩みを入れて診断結果と照らし合わせてください。</p>
            <a class="text-link" href="/diagnosis/">サーフボード診断へ →</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="section guide-related">
      <div class="container">
        <p class="kicker">RELATED GUIDES</p>
        <h2>次に読む</h2>
        <div class="guide-related-grid">
          {related.map((item) => (
            <a href={item.href}>
              <strong>{item.label}</strong>
              <p>{item.text}</p>
              <span>読む →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</BaseLayout>

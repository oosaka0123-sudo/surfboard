---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { ACTIVE_BOARD_MODELS } from '../data/boards';
import { BOARD_TYPE_BY_CATEGORY, boardTypeBySlug, type BoardType } from '../data/boardTypes';

interface Props {
  family: 'competition' | 'retro-fish' | 'midlength';
  eyebrow: string;
  title: string;
  lead: string;
  featureItems: Array<{ title: string; text: string }>;
  categories: Array<'performance' | 'fish' | 'twin' | 'midlength'>;
  variant: 'shortboard' | 'fish' | 'midlength';
  seoTitle: string;
  seoDescription: string;
}

const { family, eyebrow, title, lead, featureItems, categories, variant, seoTitle, seoDescription } = Astro.props;
const boards = ACTIVE_BOARD_MODELS.filter((board) => categories.includes(board.category as any));
const titleText = family === 'competition' ? 'ショートボード' : family === 'retro-fish' ? 'レトロフィッシュ' : 'ミッドレングス';
const description = seoDescription;

const heroBoard = boardTypeBySlug({ shortboard: 'hybrid', fish: 'fish-twin', midlength: 'midlength' }[variant] as BoardType['slug']);
const typeFor = (category: string) => boardTypeBySlug(BOARD_TYPE_BY_CATEGORY[category] ?? 'hybrid');
---

<BaseLayout
  title={seoTitle}
  description={description}
  breadcrumbs={[
    { name: 'ホーム', path: '/' },
    { name: titleText, path: Astro.url.pathname },
  ]}
>
  <SiteHeader />
  <main class={`category-page category-${variant}`}>
    <section class="category-hero">
      <div class="category-media" aria-hidden="true">
        <video autoplay muted loop playsinline preload="metadata" poster="/og-default.svg">
          <source src="/media/hero-surf.mp4" type="video/mp4" />
        </video>
        <div class="category-overlay"></div>
      </div>
      <div class="container category-hero-inner">
        <div class="category-copy">
          <p class="category-eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p>{lead}</p>
          <div class="category-actions">
            <a class="button button-primary" href="#recommend">おすすめを見る →</a>
            <a class="button button-ghost" data-category-diagnosis href={`/diagnosis?family=${family}`}>この系統で診断する</a>
          </div>
        </div>
        <div class="category-board-wrap" aria-hidden="true">
          <img class="category-board-img" src={heroBoard.image} width={heroBoard.width} height={heroBoard.height} alt="" decoding="async" />
        </div>
      </div>
      <div class="container category-features">
        {featureItems.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section category-recommend" id="recommend">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="kicker">VERIFIED PICKS</p>
            <h2>おすすめの{titleText}</h2>
          </div>
          <p>メーカー一次情報で確認できたモデルだけを掲載しています。確認できない仕様は推測しません。</p>
        </div>

        <div class="category-model-grid">
          {boards.map((board) => (
            <article class="category-model-card">
              <div class="category-model-board" aria-hidden="true">
                <img src={typeFor(board.category).image} width={typeFor(board.category).width} height={typeFor(board.category).height} alt="" loading="lazy" decoding="async" />
              </div>
              <div class="category-model-copy">
                <p class="category-model-meta">{board.brand}</p>
                <h3>{board.model}</h3>
                <p>{board.representativeSku.length} × {board.representativeSku.widthIn}" × {board.representativeSku.thicknessIn}" / {board.representativeSku.volumeL}L</p>
                {board.stockSkus?.length && <p>標準サイズ {board.stockSkus[0].length}〜{board.stockSkus[board.stockSkus.length - 1].length} / {board.stockSkus.length}サイズ確認済み</p>}
                <div class="category-model-tags">
                  {board.verifiedClaims.smallWaveFocus && <span>小波</span>}
                  {board.verifiedClaims.speedFocus && <span>スピード</span>}
                  {board.verifiedClaims.highPerformance && <span>パフォーマンス</span>}
                  {board.verifiedClaims.allConditions && <span>幅広い波</span>}
                  {board.verifiedClaims.extraPaddlePower && <span>パドル</span>}
                </div>
                <a href={board.source.url} target="_blank" rel="noopener">メーカー情報を見る ↗</a>
              </div>
            </article>
          ))}
        </div>

        {boards.length < 3 && (
          <p class="category-db-note">このカテゴリは検証済みモデルを順次追加中です。数を埋めるための未確認モデルは掲載しません。</p>
        )}
      </div>
    </section>

    <section class="section category-diagnosis-cta">
      <div class="container category-cta-box">
        <div>
          <p class="kicker">YOUR NEXT BOARD</p>
          <h2>今の自分に合う<br />{titleText}を絞る。</h2>
          <p>身長・体重だけでL数を決めず、入水頻度、技術、テイクオフ成功率、いつもの波、悩み、目的から候補を絞ります。</p>
        </div>
        <a class="button button-primary" data-category-diagnosis href={`/diagnosis?family=${family}`}>無料診断をはじめる →</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const categoryParams = new URLSearchParams(window.location.search);
  const issue = categoryParams.get('issue');
  const allowedIssues = new Set(['paddle-hard','miss-wave','pearling','no-speed','hard-turn','unstable','none']);
  if (issue && allowedIssues.has(issue)) {
    document.querySelectorAll<HTMLAnchorElement>('[data-category-diagnosis]').forEach((link) => {
      const url = new URL(link.href);
      url.searchParams.set('issue', issue);
      link.href = url.pathname + url.search;
    });
  }
</script>

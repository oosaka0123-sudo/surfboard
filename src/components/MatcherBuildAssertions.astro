---
import { ACTIVE_BOARD_MODELS, BOARD_MODELS } from '../data/boards';
import { recommendBoardRoutes, recommendBoards } from '../lib/matcher';
import type { DiagnosisInput } from '../lib/diagnosis';

function assert(condition: unknown, message: string): asserts condition {
  if (!condition) throw new Error(`Matcher build assertion failed: ${message}`);
}

assert(ACTIVE_BOARD_MODELS.length >= 10, 'verified live database should contain at least 10 active models');
assert(ACTIVE_BOARD_MODELS.every((board) => board.status === 'active'), 'research models must never enter live matching');
assert(BOARD_MODELS.some((board) => board.status === 'research'), 'research queue should remain explicit');

const earlyStage: DiagnosisInput = {
  boardFamily: 'unsure',
  heightCm: 170,
  weightKg: 68,
  frequency: '2-4',
  skill: 'takeoff',
  takeoffRate: '3-5',
  currentBoard: { volumeL: 32 },
  waveSize: 'knee-thigh',
  issue: 'miss-wave',
  goal: 'more-waves',
};

const earlyMatches = recommendBoards(earlyStage);
assert(earlyMatches.length > 0, 'early-stage small-wave case should return at least one verified candidate');
assert(
  earlyMatches.every((match) => match.board.category !== 'twin' && match.board.category !== 'performance'),
  'early-stage users must not receive twin/performance candidates',
);

const experiencedAlternative: DiagnosisInput = {
  boardFamily: 'unsure',
  heightCm: 175,
  weightKg: 72,
  frequency: '5-8',
  skill: 'cutback',
  takeoffRate: '9-10',
  currentBoard: { volumeL: 31 },
  waveSize: 'waist-chest',
  issue: 'none',
  goal: 'new-feel',
};

const alternativeMatches = recommendBoards(experiencedAlternative);
assert(
  alternativeMatches.some((match) => ['fish', 'twin', 'midlength'].includes(match.board.category)),
  'experienced new-feel case should surface an alternative-shape category',
);

const routedAlternative = recommendBoardRoutes(experiencedAlternative);
const routedIds = routedAlternative.map((match) => match.board.id);
assert(
  new Set(routedIds).size === routedIds.length,
  'the three result routes must not repeat the same board model',
);
assert(
  routedAlternative.some((match) => match.route === 'alternative'),
  'experienced new-feel case should produce an alternative route',
);

const overheadCase: DiagnosisInput = {
  boardFamily: 'unsure',
  heightCm: 178,
  weightKg: 75,
  frequency: '5-8',
  skill: 'cutback',
  takeoffRate: '9-10',
  currentBoard: { volumeL: 32 },
  waveSize: 'overhead',
  issue: 'none',
  goal: 'speed',
};

const overheadMatches = recommendBoards(overheadCase);
assert(
  overheadMatches.every((match) => match.board.verifiedClaims.holdProjectionClaim),
  'overhead candidates without explicit hold evidence must be excluded',
);
---


const familyBase: DiagnosisInput = {
  boardFamily: 'retro-fish',
  heightCm: 172,
  weightKg: 70,
  frequency: '5-8',
  skill: 'cutback',
  takeoffRate: '9-10',
  currentBoard: {},
  waveSize: 'waist-chest',
  issue: 'none',
  goal: 'new-feel',
};

const retroMatches = recommendBoards(familyBase);
assert(retroMatches.length > 0, 'retro-fish selection should return at least one verified candidate');
assert(
  retroMatches.every((match) => ['fish', 'twin'].includes(match.board.category)),
  'retro-fish selection must never return another board family',
);

const midMatches = recommendBoards({ ...familyBase, boardFamily: 'midlength' });
assert(midMatches.length > 0, 'midlength selection should return at least one verified candidate');
assert(
  midMatches.every((match) => match.board.category === 'midlength'),
  'midlength selection must never return another board family',
);

const competitionMatches = recommendBoards({
  ...familyBase,
  boardFamily: 'competition',
  goal: 'action',
  waveSize: 'shoulder-head',
});
assert(
  competitionMatches.every((match) => match.board.category === 'performance'),
  'competition selection must never return another board family',
);

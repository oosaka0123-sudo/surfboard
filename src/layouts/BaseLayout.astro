---
import { SITE } from '../config/site';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = SITE.name,
  description = SITE.description,
  image = '/og-default.svg',
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage = new URL(image, Astro.site);
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).toString(),
      name: SITE.name,
      url: Astro.site?.toString(),
      inLanguage: SITE.locale,
      description: SITE.description,
    },
    {
      '@type': 'WebPage',
      '@id': canonical.toString(),
      url: canonical.toString(),
      name: pageTitle,
      description,
      inLanguage: SITE.locale,
      isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
    },
    ...(breadcrumbs.length > 0
      ? [{
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbs.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: new URL(item.path, Astro.site).toString(),
          })),
        }]
      : []),
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#102126" />
    <meta name="color-scheme" content="light" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>

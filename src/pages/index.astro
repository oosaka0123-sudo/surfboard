---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const smallWaveImage = 'data:image/webp;base64,';
const fishImage = 'data:image/webp;base64,';
const midlengthImage = 'data:image/webp;base64,';
const stepUpImage = 'data:image/webp;base64,';

const boardStyles = [
  { slug: 'small-wave', title: 'SMALL WAVE', text: '小波で速く、楽に。', image: smallWaveImage, href: '/shortboard/' },
  { slug: 'hybrid', title: 'HYBRID', text: '波数と動きのちょうど真ん中。', image: smallWaveImage, href: '/shortboard/' },
  { slug: 'fish-twin', title: 'FISH / TWIN', text: '速さと抜け感を楽しむ。', image: fishImage, href: '/retro-fish/' },
  { slug: 'midlength', title: 'MIDLENGTH', text: '余裕を残して、まだ動ける。', image: midlengthImage, href: '/midlength/' },
  { slug: 'step-up', title: 'STEP-UP', text: 'サイズが上がった日の安心感。', image: stepUpImage, href: '/boards/' },
];

const troubles = [
  { label: 'パドルがしんどい', issue: 'paddle-hard' },
  { label: 'テイクオフで置いていかれる', issue: 'miss-wave' },
  { label: '立てるけど板が走らない', issue: 'no-speed' },
  { label: '走れるけどターンしづらい', issue: 'hard-turn' },
  { label: '動くけど不安定', issue: 'unstable' },
  { label: '次の1本が分からない', issue: 'none' },
];
---

<BaseLayout
  title="45〜60歳のサーフボード選び・無料診断"
  description="45〜60歳の週末サーファー向けサーフボード診断。ショートボード、レトロフィッシュ、ミッドレングスをメーカー一次情報と現在の技術・波・悩みから比較します。"
>
  <SiteHeader />
  <main>
    <section class="hero hero-video" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        <video autoplay muted loop playsinline preload="metadata" src="/media/hero-surf.mp4"></video>
        <div class="hero-fallback"></div>
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-board-stage" aria-hidden="true">
        <svg class="hero-retro-fish" viewBox="0 0 260 620" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <defs>
            <linearGradient id="retroFishDeck" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ffffff" stop-opacity=".30" />
              <stop offset="55%" stop-color="#d8fff8" stop-opacity=".12" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity=".08" />
            </linearGradient>
          </defs>
          <path
            class="retro-fish-body"
            d="M130 14
               C88 14 55 48 44 108
               C26 214 33 382 66 515
               C76 555 88 586 105 608
               L130 578
               L155 608
               C172 586 184 555 194 515
               C227 382 234 214 216 108
               C205 48 172 14 130 14 Z"
          />
          <path class="retro-fish-stringer" d="M130 32 L130 575" />
          <path class="retro-fish-rail" d="M130 31 C95 30 66 57 55 112 C38 213 44 374 75 505" />
          <path class="retro-fish-rail" d="M130 31 C165 30 194 57 205 112 C222 213 216 374 185 505" />
          <circle class="retro-fish-logo-ring" cx="130" cy="126" r="31" />
          <text class="retro-fish-logo" x="130" y="135" text-anchor="middle">SF</text>
          <path class="retro-fish-keel" d="M84 500 C75 524 75 553 88 574 C101 555 103 525 96 500 Z" />
          <path class="retro-fish-keel" d="M176 500 C185 524 185 553 172 574 C159 555 157 525 164 500 Z" />
        </svg>
        <span class="retro-fish-caption">RETRO FISH / TWIN</span>
      </div>
      <div class="hero-orbit orbit-one">SHORT / FISH / TWIN</div>
      <div class="hero-orbit orbit-two">MIDLENGTH / STEP-UP</div>
      <div class="container hero-content">
        <p class="hero-category">45〜60歳のための <strong>サーフボード診断</strong></p>
        <p class="eyebrow">NEXT BOARD, BETTER SURF</p>
        <h1 id="hero-title"><span class="hero-line">今の自分に合う</span><span class="hero-line">サーフボード、</span><span class="hero-line hero-accent">もう迷わない。</span></h1>
        <p class="lead">まず「コンペ用・レトロフィッシュ・ミッドレングス」から方向を選び、今の自分に合う候補を絞ります。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/diagnosis/">サーフボード診断をはじめる</a>
          <a class="button button-ghost" href="#styles">ボードタイプを見る</a>
        </div>
        <div class="hero-meta" aria-label="診断の特徴">
          <span>NO LONGBOARD</span><span>RULE BASED</span><span>MOBILE FIRST</span>
        </div>
      </div>
      <a class="scroll-cue" href="#diagnosis" aria-label="診断セクションへ">SCROLL ↓</a>
    </section>

    <section id="diagnosis" class="section intro-section">
      <div class="container split">
        <div>
          <p class="kicker">01 / DIAGNOSIS</p>
          <h2>L数だけでは、<br />あなたの板は決まらない。</h2>
        </div>
        <div class="intro-copy">
          <p>同じ30Lでも、幅・ロッカー・テール・レールで乗り味は別物。だからこのサイトは「何L？」で終わらず、今のあなたとの相性を見ます。</p>
          <a class="text-link" href="#how">診断の考え方を見る →</a>
        </div>
      </div>
    </section>

    <section class="section trouble-section">
      <div class="container">
        <p class="kicker">WHAT'S YOUR ISSUE?</p>
        <h2>今いちばん近いのは？</h2>
        <div class="trouble-grid">
          {troubles.map((item, i) => (
            <a class="trouble-chip" href={`/diagnosis/?issue=${item.issue}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>{item.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="styles" class="section board-section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="kicker">02 / BOARD TYPES</p>
            <h2>次の1本は、5つの方向から。</h2>
          </div>
          <p>ロングボードは対象外。ショート〜ミッドの「まだ動ける、でも楽」を中心に比較します。</p>
        </div>
        <div class="board-grid">
          {boardStyles.map((board, i) => (
            <a class="board-card" href={board.href} aria-label={`${board.title} の選び方と検証済みボードを見る`}>
              <span class="board-number">{String(i + 1).padStart(2, '0')}</span>
              <div class="board-shape-wrap" aria-hidden="true">
                <img class={`board-type-img board-type-img-${board.slug}`} src={board.image} alt="" loading="lazy" decoding="async" />
              </div>
              <h3>{board.title}</h3>
              <p>{board.text}</p>
              <span class="card-arrow">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="how" class="section how-section">
      <div class="container">
        <p class="kicker">03 / HOW IT WORKS</p>
        <h2>1分半で、今の自分を整理する。</h2>
        <div class="steps">
          <article><span>01</span><h3>今の自分</h3><p>身長・体重と、月に何回くらい海へ行くか。</p></article>
          <article><span>02</span><h3>今の技術</h3><p>最近どこまでできるかと、テイクオフ成功率。</p></article>
          <article><span>03</span><h3>今の悩み</h3><p>「しんどい」「遅れる」「動かない」など具体的に。</p></article>
          <article><span>04</span><h3>次の1本</h3><p>選んだ系統の中から、普段の波と目的に合う候補を絞ります。</p></article>
        </div>
      </div>
    </section>

    <section class="section result-preview">
      <div class="container result-shell">
        <div class="result-copy">
          <p class="kicker">RESULT PREVIEW</p>
          <h2>数字より、<br />「なぜ合うか」が分かる。</h2>
          <p>診断理由は発火ルールから表示。AIが雰囲気でおすすめするサイトにはしません。</p>
        </div>
        <div class="result-card">
          <span class="fit-label">かなり合う</span>
          <strong>条件一致 7 / 8</strong>
          <ul>
            <li>小波中心の波質に合う</li>
            <li>現板よりパドルを楽にしやすい</li>
            <li>極端なダウンサイジングを避けている</li>
          </ul>
          <small>注意：テールが細くなるため、最初は安定感が少し落ちる可能性があります。</small>
        </div>
      </div>
    </section>


    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="kicker">04 / SURFBOARD GUIDES</p>
            <h2>迷いやすいところから、<br />先に整理する。</h2>
          </div>
          <p>年齢やL数だけで決めず、次の1本を選ぶ前に知っておきたいポイントをテーマ別にまとめています。</p>
        </div>
        <div class="trouble-grid">
          <a class="trouble-chip" href="/guides/50s-surfboard/"><span>01</span>50代のサーフボード選び</a>
          <a class="trouble-chip" href="/guides/midlength-size/"><span>02</span>ミッドレングスの長さ選び</a>
          <a class="trouble-chip" href="/guides/fish-vs-twin/"><span>03</span>フィッシュとツインの違い</a>
          <a class="trouble-chip" href="/guides/"><span>04</span>選び方ガイドをすべて見る</a>
        </div>
      </div>
    </section>

    <section class="section final-cta">
      <div class="container cta-box">
        <p class="kicker">READY?</p>
        <h2>昔のベストではなく、<br />今のベストを。</h2>
        <a class="button button-dark" href="/diagnosis/">次の1本を探す</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

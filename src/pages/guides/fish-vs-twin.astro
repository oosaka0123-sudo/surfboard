---
import GuideArticle from '../../components/GuideArticle.astro';

const sections = [
  {
    heading: 'フィッシュは形、ツインはフィン構成',
    paragraphs: [
      '「フィッシュ」と「ツイン」は同じ意味ではありません。フィッシュは一般に幅広いアウトラインや特徴的なテールを持つボード形状の呼び方で、ツインは2本フィンを中心としたフィン構成を指します。',
      'フィッシュ形状でもクアッドを使うモデルがあり、ツインでも細めでパフォーマンス寄りのモデルがあります。名前だけで乗り味を決めつけないことが大切です。',
    ],
  },
  {
    heading: '小波で楽しい理由はモデルごとに違う',
    paragraphs: [
      '小波向けモデルには、広い面積、低めのロッカー、パドル面積、スピードを維持しやすい設計など、メーカーごとに異なる狙いがあります。',
      '「ツインだから速い」「フィッシュだから簡単」と一括りにせず、メーカーが何を設計意図として説明しているかを確認します。',
    ],
  },
  {
    heading: 'スラスターから乗り換える時に見ること',
    bullets: [
      'ターンの入り方が変わることを許容できるか',
      '縦へのアクションより、スピードやラインの変化を楽しみたいか',
      '普段の波が小波中心か、サイズのある波も使いたいか',
      'フィン構成とメーカー推奨レンジが自分の用途に合うか',
    ],
  },
  {
    heading: '最初の1本は用途を狭く決める',
    paragraphs: [
      '初めてフィッシュ／ツイン系を選ぶなら、「小波の日を楽しむ」「今と違うラインを試す」など用途を1つ決める方が選びやすくなります。',
      'Surfboard Finderでは、フィッシュとツインを同じ家族として比較しつつ、モデルごとのカテゴリーと公式根拠を分けて表示します。',
    ],
  },
];

const related = [
  { href: '/retro-fish/', label: 'レトロフィッシュ比較', text: '検証済みフィッシュ／ツインを見る。' },
  { href: '/guides/50s-surfboard/', label: '50代のサーフボード選び', text: '次の1本の優先順位を整理。' },
  { href: '/diagnosis/?family=retro-fish', label: 'レトロフィッシュ診断', text: '条件から候補を絞る。' },
];
---
<GuideArticle
  title="フィッシュとツインの違い｜サーフボード選びで混同しやすいポイント"
  description="フィッシュとツインの違いを解説。フィッシュはボード形状、ツインはフィン構成という基本から、小波適性やスラスターとの違いを整理します。"
  eyebrow="GUIDE / FISH & TWIN"
  h1="フィッシュとツインの違い"
  lead="似ているようで別の言葉。形とフィン構成を分けると、次の1本の選び方が分かりやすくなります。"
  sections={sections}
  related={related}
/>

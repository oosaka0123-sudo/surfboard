---
import GuideArticle from '../../components/GuideArticle.astro';

const sections = [
  {
    heading: 'ミッドレングスは長ければ楽、ではない',
    paragraphs: [
      'ミッドレングスは長さが増えるほど単純に楽になるわけではありません。長さに加えて、幅、厚み、ロッカー、レール、フィン構成でパドル感やターンの大きさが変わります。',
      '最初に「波数を増やしたい」「パドルに余裕が欲しい」「大きなラインで滑りたい」のどれを優先するか決めると、長さを考えやすくなります。',
    ],
  },
  {
    heading: '普段のポイントと混雑も見る',
    paragraphs: [
      '広いビーチブレイクと、ピークが狭い混雑ポイントでは扱いやすい長さが違います。取り回しやドルフィンスルー、駐車・保管まで含めると、最長サイズが常に正解とは限りません。',
      '普段の波が小さく弱いなら波をつかむ余裕を、肩〜頭以上が多いならホールドやコントロールのメーカー根拠を優先して確認します。',
    ],
  },
  {
    heading: '長さより先に「何を楽にしたいか」',
    bullets: [
      'パドルを楽にしたい：前方の面積やメーカーのパドル性能説明を確認',
      '波数を増やしたい：テイクオフの入りやすさや小波対応の根拠を確認',
      'ターンもしたい：レール、テール、フィン構成とパフォーマンス用途を確認',
      'サイズのある波も乗りたい：ホールドやプロジェクションの明記を確認',
    ],
  },
  {
    heading: '最終サイズはモデルごとのSKU表で決める',
    paragraphs: [
      '「7ft台なら何でも同じ」ではありません。同じ長さでもボリュームや幅が大きく違うため、モデルを決めた後にメーカー標準サイズ表を見ます。',
      'Surfboard Finderでは、確認できたモデルからSKU表を順次収録し、未確認のサイズを推測で埋めない方針です。',
    ],
  },
];

const related = [
  { href: '/midlength/', label: 'ミッドレングス比較', text: '検証済みモデルを確認。' },
  { href: '/guides/50s-surfboard/', label: '50代のサーフボード選び', text: '年齢以外の判断条件を整理。' },
  { href: '/diagnosis/?family=midlength', label: 'ミッドレングス診断', text: '条件から候補を絞る。' },
];
---
<GuideArticle
  title="ミッドレングスの長さ選び｜何フィートが合うか決める前に"
  description="ミッドレングスの長さ選びを解説。7ft前後など長さだけで決めず、パドル、波数、操作性、普段の波、メーカーSKU表から考える方法を整理します。"
  eyebrow="GUIDE / MIDLENGTH"
  h1="ミッドレングスの長さ選び"
  lead="「何フィートが正解？」の前に、何を楽にしたいかを決める。長さ・幅・設計意図を分けて考えます。"
  sections={sections}
  related={related}
/>

---
import GuideArticle from '../../components/GuideArticle.astro';

const sections = [
  {
    heading: '50代だから浮力を増やす、では決めない',
    paragraphs: [
      '年齢だけを理由に「もっと大きい板」「もっと多いL数」と決めると、今の技術や波に合わないことがあります。見るべきなのは、月に何回入るか、テイクオフがどの程度安定しているか、今の板で何に困っているかです。',
      '同じ体重でも、週末に月2回の人と週2回入る人では、必要な余裕や反応性のバランスが違います。Surfboard Finderでは年齢を直接の増量ルールには使いません。',
    ],
  },
  {
    heading: '最初に確認したい4つ',
    bullets: [
      'テイクオフ成功率：10回のチャンスで何回立てるか',
      '入水頻度：月0〜1回、2〜4回、5〜8回、9回以上のどこか',
      '普段の波：ヒザ〜モモ、腰〜胸、肩〜頭、頭オーバー',
      '今の悩み：パドル、波に置いていかれる、スピード、不安定さ、ターンの重さ',
    ],
    paragraphs: [
      'ここが決まると、「ショートの反応性を残す」「フィッシュで小波を楽しむ」「ミッドレングスで波数を増やす」といった方向が見えやすくなります。',
    ],
  },
  {
    heading: 'L数は最後にモデル内で確認する',
    paragraphs: [
      'L数は重要ですが、先にL数だけ決めると、幅・ロッカー・レール・フィン構成の違いを見落とします。まずモデルの方向を決め、そのモデルのメーカー標準サイズ表から候補を確認する方が安全です。',
      '最終サイズは、メーカー公式スペック、ショップでの相談、可能なら試乗まで含めて決めるのが現実的です。',
    ],
  },
  {
    heading: '迷ったら「楽に乗る」と「まだ動ける」を分ける',
    paragraphs: [
      'パドルや波数の余裕を優先するのか、ターンやアクション性能を優先するのかで選択は変わります。どちらも欲しい場合でも、まず優先順位を1つ決めた方が候補を絞りやすくなります。',
      '「昔乗れていた板」ではなく、「今の入水頻度と波で気持ちよく乗れる板」を基準にするのが、このサイトの基本方針です。',
    ],
  },
];

const related = [
  { href: '/guides/midlength-size/', label: 'ミッドレングスの長さ選び', text: '波数と操作性のバランスを整理。' },
  { href: '/guides/fish-vs-twin/', label: 'フィッシュとツインの違い', text: '小波用の選択肢を整理。' },
  { href: '/method/', label: '診断の仕組み', text: '推薦ルールとデータ方針を確認。' },
];
---
<GuideArticle
  title="50代のサーフボード選び｜年齢より見るべき4つの条件"
  description="50代のサーフボード選びを、年齢やL数だけで決めない方法で解説。入水頻度、テイクオフ成功率、普段の波、今の悩みから次の1本を整理します。"
  eyebrow="GUIDE / 50s SURFER"
  h1="50代のサーフボード選び"
  lead="年齢だけで浮力を増やさない。今の技術、入水頻度、普段の波、悩みから「次の1本」の方向を決めます。"
  sections={sections}
  related={related}
/>
